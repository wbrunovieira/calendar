// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  avatarUrl    String?  @map("avatar_url")
  timezone     String   @default("America/Sao_Paulo")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  calendars Calendar[]
  reports   Report[]

  @@index([email])
  @@map("users")
}

model Calendar {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  name             String
  email            String?
  color            String // HEX color (#350545)
  type             String // 'professional' | 'personal'
  googleCalendarId String?   @map("google_calendar_id")
  googleSyncToken  String?   @map("google_sync_token") @db.Text
  lastSyncAt       DateTime? @map("last_sync_at")
  financeProfileId String?   @map("finance_profile_id")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories    Category[]
  categoryTypes CategoryType[]
  events        Event[]
  labels        Label[]

  @@index([userId])
  @@index([googleCalendarId])
  @@index([financeProfileId])
  @@map("calendars")
}

model CategoryType {
  id         String   @id @default(uuid())
  calendarId String   @map("calendar_id")
  name       String // "Trabalho", "Saúde", etc
  value      String // "work", "health", etc (slug/key)
  icon       String? // Emoji opcional
  color      String // HEX color
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  calendar   Calendar         @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  categories CategoryToType[]
  events     Event[]

  @@unique([calendarId, value])
  @@index([calendarId])
  @@index([value])
  @@map("category_types")
}

model Category {
  id         String   @id @default(uuid())
  calendarId String   @map("calendar_id")
  name       String
  icon       String? // Emoji (🏃, 💼)
  color      String // HEX color
  type       String? // 'health', 'work', 'leisure', etc (DEPRECATED - usar categoryTypes relation)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  calendar      Calendar         @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  events        Event[]
  monthlyGoals  MonthlyGoal[]
  categoryTypes CategoryToType[]

  @@index([calendarId])
  @@map("categories")
}

model Label {
  id         String   @id @default(uuid())
  calendarId String   @map("calendar_id")
  name       String
  color      String // HEX color
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  events   Event[]

  @@index([calendarId])
  @@map("labels")
}

// Many-to-many relationship between Category and CategoryType
model CategoryToType {
  id             String   @id @default(uuid())
  categoryId     String   @map("category_id")
  categoryTypeId String   @map("category_type_id")
  createdAt      DateTime @default(now()) @map("created_at")

  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryType CategoryType @relation(fields: [categoryTypeId], references: [id], onDelete: Cascade)

  @@unique([categoryId, categoryTypeId])
  @@index([categoryId])
  @@index([categoryTypeId])
  @@map("category_to_types")
}

model Event {
  id                    String    @id @default(uuid())
  calendarId            String    @map("calendar_id")
  categoryId            String?   @map("category_id")
  categoryTypeId        String?   @map("category_type_id")
  labelId               String?   @map("label_id")
  title                 String
  description           String?
  startTime             String    @map("start_time") // TIME stored as string (HH:mm)
  endTime               String?   @map("end_time")
  startDate             DateTime  @map("start_date") @db.Date
  endDate               DateTime? @map("end_date") @db.Date

  // Recorrência (RRULE simplificado)
  recurrenceRule        String?   @map("recurrence_rule") // RRULE format ou NULL para eventos one-time

  // Hierarquia de eventos recorrentes (Google Calendar Pattern)
  // NULL = é um evento master (recorrente ou one-time normal)
  // UUID = é um evento derivado/filho de outro evento recorrente
  recurrenceMasterId    String?   @map("recurrence_master_id")

  // Status do evento
  status                String    @default("CONFIRMED") // CONFIRMED, CANCELLED, TENTATIVE

  // Tipo de evento: EVENT (compromisso), HABIT (habito), TODO (tarefa)
  eventType             String    @default("EVENT") @map("event_type")

  // Para TODOs: prioridade (1=alta, 2=media, 3=baixa)
  priority              Int?

  // Para TODOs: data de vencimento
  dueDate               DateTime? @map("due_date") @db.Date

  // Para REMINDERs: dias de antecedência para lembrar (ex: [7, 3, 1, 0] = 7 dias antes, 3 dias antes, etc)
  reminderDaysBefore    Int[]     @map("reminder_days_before")

  // Ordem de exibição para drag and drop
  displayOrder          Int       @default(0) @map("display_order")

  // Hábitos semanais flexíveis
  recurrenceType        String?   @map("recurrence_type") // "FIXED" | "FLEXIBLE"
  weeklyTargetCount     Int?      @map("weekly_target_count") // Meta semanal (ex: 2 vezes por semana)
  weeklyPreferredDays   String[]  @map("weekly_preferred_days") // Dias preferidos ["MO", "TU", "WE", "TH", "FR", "SA", "SU"]

  // Google Calendar
  googleEventId         String?   @map("google_event_id")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  calendar              Calendar              @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  category              Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryType          CategoryType?         @relation(fields: [categoryTypeId], references: [id], onDelete: SetNull)
  label                 Label?                @relation(fields: [labelId], references: [id], onDelete: SetNull)
  recurrenceMaster      Event?                @relation("RecurrenceHierarchy", fields: [recurrenceMasterId], references: [id], onDelete: Cascade)
  derivedEvents         Event[]               @relation("RecurrenceHierarchy")

  // Separação de responsabilidades
  exceptions            RecurrenceException[] @relation("EventExceptions")
  overrides             RecurrenceOverride[]  @relation("MasterEventOverrides")
  overriddenBy          RecurrenceOverride[]  @relation("OverrideEvent")
  completions           EventCompletion[]
  reminders             EventReminder[]
  weeklyGoalCompletions WeeklyGoalCompletion[]

  @@index([calendarId])
  @@index([categoryId])
  @@index([categoryTypeId])
  @@index([labelId])
  @@index([startDate])
  @@index([recurrenceMasterId])
  @@index([googleEventId])
  @@index([status])
  @@index([eventType])
  // Guard-rail against duplicates from the Google Calendar sync.
  // Postgres treats NULLs as distinct, so locally-created events (googleEventId NULL) never collide.
  @@unique([calendarId, googleEventId])
  @@map("events")
}

// Exceções: datas removidas da recorrência
model RecurrenceException {
  id            String   @id @default(uuid())
  eventId       String   @map("event_id")
  exceptionDate DateTime @map("exception_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  event Event @relation("EventExceptions", fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, exceptionDate])
  @@index([eventId])
  @@index([exceptionDate])
  @@map("recurrence_exceptions")
}

// Sobrescritas: modificações em ocorrências específicas
model RecurrenceOverride {
  id              String   @id @default(uuid())
  masterEventId   String   @map("master_event_id")
  occurrenceDate  DateTime @map("occurrence_date") @db.Date
  overrideEventId String   @map("override_event_id")
  createdAt       DateTime @default(now()) @map("created_at")

  masterEvent   Event @relation("MasterEventOverrides", fields: [masterEventId], references: [id], onDelete: Cascade)
  overrideEvent Event @relation("OverrideEvent", fields: [overrideEventId], references: [id], onDelete: Cascade)

  @@unique([masterEventId, occurrenceDate])
  @@index([masterEventId])
  @@index([overrideEventId])
  @@index([occurrenceDate])
  @@map("recurrence_overrides")
}

// Completions: checkboxes de conclusão (SEPARADO de modificações)
model EventCompletion {
  id             String    @id @default(uuid())
  eventId        String    @map("event_id")
  occurrenceDate DateTime  @map("occurrence_date") @db.Date
  completed      Boolean   @default(false)
  completedAt    DateTime? @map("completed_at")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, occurrenceDate])
  @@index([eventId])
  @@index([occurrenceDate])
  @@index([completed])
  @@map("event_completions")
}

// Tracking de metas semanais para hábitos flexíveis
model WeeklyGoalCompletion {
  id              String   @id @default(uuid())
  eventId         String   @map("event_id")
  weekStartDate   DateTime @map("week_start_date") @db.Date // Segunda-feira da semana
  targetCount     Int      @map("target_count") // Meta (ex: 2)
  completedCount  Int      @default(0) @map("completed_count") // Quantas vezes fez
  completedDates  String[] @map("completed_dates") // Datas em que completou (YYYY-MM-DD)
  isGoalMet       Boolean  @default(false) @map("is_goal_met") // true se completedCount >= targetCount
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, weekStartDate])
  @@index([eventId])
  @@index([weekStartDate])
  @@index([isGoalMet])
  @@map("weekly_goal_completions")
}

model EventReminder {
  id            String   @id @default(uuid())
  eventId       String   @map("event_id")
  minutesBefore Int      @map("minutes_before")
  method        String // 'email', 'notification', 'sms'
  createdAt     DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_reminders")
}

model MonthlyGoal {
  id               String   @id @default(uuid())
  categoryId       String   @map("category_id")
  month            DateTime @db.Date // Primeiro dia do mês (2025-10-01)
  targetExecutions Int      @map("target_executions")
  description      String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month])
  @@index([categoryId])
  @@index([month])
  @@map("monthly_goals")
}

model GoogleOAuthToken {
  id           String   @id @default(uuid())
  email        String   @unique // Google account email — chave de lookup
  accessToken  String   @map("access_token") @db.Text
  refreshToken String   @map("refresh_token") @db.Text
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("google_oauth_tokens")
}

model Report {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  month      DateTime @db.Date
  data       Json // Relatório completo em JSON
  aiInsights String[] @map("ai_insights")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
  @@index([month])
  @@map("reports")
}
