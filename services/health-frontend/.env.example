# Backends reached by the server-side proxies (app/api/health-backend, app/api/calendar-backend).
# Runtime env, server only: nothing here is inlined into the browser bundle.
HEALTH_API_URL=http://localhost:3336/api/v1
HEALTH_API_TOKEN=
CALENDAR_API_URL=http://localhost:3334
CALENDAR_API_TOKEN=

# Login (password + TOTP), same values as calendar-frontend. Blank AUTH_SESSION_SECRET = no login.
# `npm run auth:setup` prints them. On plain-http local dev set AUTH_INSECURE_COOKIE=true.
AUTH_SESSION_SECRET=
AUTH_PASSWORD_HASH=
AUTH_TOTP_SECRET=
AUTH_INSECURE_COOKIE=
