# Finances Go backend
NEXT_PUBLIC_API_URL=http://localhost:3335/api/v1

# calendar-core (used by the settings page to list calendars)
NEXT_PUBLIC_CALENDAR_API_URL=http://localhost:3334
# Must match calendar-core API_TOKEN. Empty if the backend has no token.
NEXT_PUBLIC_CALENDAR_API_TOKEN=

# Authelia gateway. MUST be set for local development: the code falls back to
# the production host, so an unset value makes the "Sair" button on
# localhost:3003 terminate the real production session.
NEXT_PUBLIC_AUTH_URL=https://auth.app.localhost
