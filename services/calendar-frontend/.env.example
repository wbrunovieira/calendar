# calendar-core, reached by the server-side proxy (app/api/backend). Runtime env, server only:
# nothing here is inlined into the browser bundle.
CALENDAR_API_URL=http://localhost:3334

# Must match calendar-core API_TOKEN. Leave empty if the backend has no token.
CALENDAR_API_TOKEN=

# Login (password + TOTP). Blank AUTH_SESSION_SECRET = no login (open). `npm run auth:setup`
# prints all three. On plain-http local dev set AUTH_INSECURE_COOKIE=true (no Secure cookie).
AUTH_SESSION_SECRET=
AUTH_PASSWORD_HASH=
AUTH_TOTP_SECRET=
AUTH_INSECURE_COOKIE=
