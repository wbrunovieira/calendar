# Database
DATABASE_URL=postgresql://calendar:calendar123@localhost:5433/calendar_db

# Server
PORT=3000
NODE_ENV=development

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3334/google-calendar/auth/callback
GOOGLE_FRONTEND_REDIRECT_URI=http://localhost:3000/settings/integrations
# Set to false to stop the 5-minute Google Calendar poll (needed while running the one-shot
# backfill script, so a tick cannot re-import a row the backfill is linking).
GOOGLE_SYNC_ENABLED=true

# Linear API
LINEAR_API_KEY=

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# Langfuse v3
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=langfuse123
LANGFUSE_POSTGRES_DB=langfuse_db
LANGFUSE_NEXTAUTH_URL=http://localhost:3100
LANGFUSE_NEXTAUTH_SECRET=          # openssl rand -hex 32
LANGFUSE_SALT=                     # openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=           # openssl rand -hex 32 (must be 64 hex chars)
LANGFUSE_CLICKHOUSE_USER=langfuse
LANGFUSE_CLICKHOUSE_PASSWORD=langfuse123
LANGFUSE_S3_ACCESS_KEY=langfuse
LANGFUSE_S3_SECRET_KEY=langfuse123
LANGFUSE_S3_BUCKET=langfuse

# agents
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OPENAI_API_KEY=

# Evolution API (WhatsApp)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# n8n
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_API_URL=
N8N_API_KEY=

# DeepSeek (LLM)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# WhatsApp — Grupo dedicado para lançamentos
WHATSAPP_GROUP_JID=

# Health Check — WhatsApp notification target (phone with country code or group JID)
WHATSAPP_NOTIFY_NUMBER=

# Finance profile IDs (calendar-finances)
FINANCE_PERSONAL_PROFILE_ID=
# FINANCE_BUSINESS_PROFILE_ID=

# Authelia (auth gateway)
AUTHELIA_JWT_SECRET=              # openssl rand -hex 32
AUTHELIA_SESSION_SECRET=          # openssl rand -hex 32
AUTHELIA_STORAGE_ENCRYPTION_KEY=  # openssl rand -hex 32