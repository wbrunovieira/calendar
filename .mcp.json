{
  "mcpServers": {
    "calendar-postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://calendar:calendar123@localhost:5433/calendar_db"
      ]
    },
    "langfuse-postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://langfuse:langfuse123@localhost:5434/langfuse_db"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    }
  }
}
